{
  "rewrites": [
    {
      "source": "/published/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/miniapp/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}